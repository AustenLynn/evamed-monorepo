# ecoinvent API — https://docs.api.ecoinvent.org/
# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Required. From https://accounts.ecoinvent.org/api
ECOINVENT_CLIENT_ID=
ECOINVENT_CLIENT_SECRET=

# Endpoints (defaults shown; override only for testing)
ECOINVENT_TOKEN_URL=https://sso.ecoinvent.org/realms/ecoinvent/protocol/openid-connect/token
ECOINVENT_API_BASE=https://api.ecoinvent.org

# Which database to read. The sandbox exposes ~10,000 of 26,000+ datasets and
# its values are NOT authoritative — do not ship them to end users.
ECOINVENT_VERSION=3.12-sandbox
ECOINVENT_SYSTEM_MODEL=cutoff

# Safety interlock: running against a non-sandbox version spends the licence's
# unique-dataset quota, so it must be opted into explicitly.
ECOINVENT_ALLOW_PRODUCTION=False

# Required only for licence usage reporting (POST /v3/api1/reports).
ECOINVENT_ORGANIZATION_ID=

ECOINVENT_TIMEOUT=30
ECOINVENT_MAX_RETRIES=3
